# Get your key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional - defaults to claude-opus-4-6 for best accuracy.
# Use claude-sonnet-4-6 for faster / cheaper, or claude-haiku-4-5-20251001 for cheapest.
ANTHROPIC_MODEL=claude-opus-4-6

# Optional - server port
PORT=3000

# Optional - path to ffmpeg binary for video frame extraction
# If ffmpeg is not installed, the server falls back to analyzing a single thumbnail per video.
FFMPEG_PATH=ffmpeg

# Optional - number of frames to extract per video (default 6)
VIDEO_FRAMES=6

# Optional - max upload size in MB per request (default 200)
MAX_UPLOAD_MB=200
